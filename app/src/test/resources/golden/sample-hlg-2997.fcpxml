<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.9">
  <resources>
    <format id="r1" name="FFVideoFormat1080p2997" frameDuration="1001/30000s" width="1920" height="1080" colorSpace="9-18-9 (Rec. 2020 HLG)"/>
    <asset id="a1" name="interview.mp4" start="0s" duration="30s" hasVideo="1" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000" format="r1">
      <media-rep kind="original-media" src="content://media/1"/>
    </asset>
    <asset id="a2" name="photo.jpg" start="0s" duration="0s" hasVideo="1" format="r1">
      <media-rep kind="original-media" src="content://media/3"/>
    </asset>
    <asset id="a3" name="song.wav" start="0s" duration="120s" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000" format="r1">
      <media-rep kind="original-media" src="file:///music/song.wav"/>
    </asset>
    <effect id="rT" name="Basic Title" uid=".../Titles.localized/Bumper:Opener.localized/Basic Title.localized/Basic Title.moti"/>
  </resources>
  <library>
    <event name="ultimateVE">
      <project name="Sample &amp; Co">
        <sequence format="r1" duration="3003/250s" tcStart="0s" tcFormat="DF" audioLayout="stereo" audioRate="48k">
          <note>Not exported: Media is referenced by Android content:// addresses; relink the files in your editor. Audio tools (pan, fades, EQ, noise suppression, mixer settings, ducking). Transform positions are written as a percentage of the frame height (unchecked in an editor). Retimed clips use a timeMap (unchecked in an editor). Marker colours are written as a text prefix. Connected clips are placed as if the clip they hang on played at normal speed.</note>
          <spine>
            <asset-clip ref="a1" offset="0s" name="interview.mp4" start="1001/1000s" duration="1001/200s" tcFormat="DF">
              <asset-clip ref="a3" lane="-1" offset="1001/1000s" name="song.wav" start="0s" duration="3003/250s" tcFormat="DF" audioRole="music"/>
              <title ref="rT" lane="2" offset="1001/500s" name="Hello &lt;World&gt; &amp; &quot;friends&quot;" start="3600s" duration="1001/500s">
                <text><text-style ref="ts1">Hello &lt;World&gt; &amp; &quot;friends&quot;</text-style></text>
                <text-style-def id="ts1"><text-style font="Helvetica Neue" fontSize="108" fontColor="1 0.502 0 1" alignment="left" bold="1"/></text-style-def>
              </title>
              <asset-clip ref="a1" lane="1" offset="3003/1000s" name="interview.mp4" start="0s" duration="3003/1000s" tcFormat="DF">
                <adjust-transform position="10 5" rotation="-10" scale="0.5 0.5"/>
                <adjust-blend amount="0.8"/>
              </asset-clip>
              <marker start="7007/2000s" duration="1001/30000s" value="[red] Cut here &amp; &lt;check&gt;" note="Cut here &amp; &lt;check&gt;"/>
              <marker start="1001/200s" duration="1001/30000s" value="Beat"/>
            </asset-clip>
            <asset-clip ref="a1" offset="1001/200s" name="interview.mp4" start="1001/100s" duration="1001/200s" tcFormat="DF">
              <adjust-volume amount="-6.0dB"/>
              <video ref="a2" lane="1" offset="7007/600s" name="photo.jpg" start="0s" duration="3003/1000s"/>
            </asset-clip>
            <asset-clip ref="a1" offset="1001/100s" name="interview.mp4" start="0s" duration="1001/500s" tcFormat="DF">
              <timeMap><timept time="0s" value="0s" interp="linear"/><timept time="1001/500s" value="1001/250s" interp="linear"/></timeMap>
            </asset-clip>
          </spine>
        </sequence>
      </project>
    </event>
  </library>
</fcpxml>
