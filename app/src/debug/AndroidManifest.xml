<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only harness to play a video through the native preview pipeline. -->
        <activity
            android:name=".debug.DebugPreviewActivity"
            android:exported="true"
            android:label="Preview debug"
            android:theme="@style/Theme.UVEditor" />
        <!-- Debug-only harness for the native timeline canvas; start with:
             adb shell am start -n com.ultimatevideo.uveditor/.debug.TimelineDemoActivity -->
        <activity
            android:name=".debug.TimelineDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.UVEditor" />
        <!-- Debug-only harness that exports a file through the native pipeline; see ExportDemoActivity. -->
        <activity
            android:name=".debug.ExportDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.UVEditor" />
        <!-- Debug-only harness that analyses a video and exports it with and without the stabiliser; see StabiliseDemoActivity. -->
        <activity
            android:name=".debug.StabiliseDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.UVEditor" />
        <!-- Debug-only harness for "Save frame as image" and the matching export; see FrameDemoActivity. -->
        <activity
            android:name=".debug.FrameDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.UVEditor" />
        <!-- Debug-only: exports a project.json through the dialog's own path (executor and foreground service); see QaExportActivity. -->
        <activity
            android:name=".debug.QaExportActivity"
            android:exported="true"
            android:theme="@style/Theme.UVEditor" />
        <!-- Debug-only: lists the HEVC encoders and trial-configures HLG formats into files/hdr-probe.txt; see HdrProbeDemoActivity. -->
        <activity
            android:name=".debug.HdrProbeDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.UVEditor" />
    </application>

</manifest>
